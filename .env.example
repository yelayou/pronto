# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Twilio — WhatsApp gateway
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886   # Sandbox number for dev/staging

# Supabase — database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Maps — geocoding, distance matrix, geofence
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Anthropic — Claude agent
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Dispatcher — your WhatsApp number in E.164 format
DISPATCHER_PHONE=+14165550123

# Payment — your Interac autodeposit email or link
ETRANSFER_LINK=yourname@email.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# QStash — async webhook processing (optional locally; required in staging/prod)
# When QSTASH_TOKEN is set, /api/webhook enqueues jobs instead of processing inline.
# If unset, the webhook falls back to synchronous processing (safe for local dev).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_BASE_URL=                   # Optional: worker callback base URL. Defaults to https://$VERCEL_URL

# Test-only — used by E2E + post-deploy smoke tests
STAGING_URL=
